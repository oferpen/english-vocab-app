# Android Release Signing Configuration
# 
# Instructions:
# 1. Create your keystore first:
#    keytool -genkey -v -keystore english-path-release-key.jks \
#      -keyalg RSA -keysize 2048 -validity 10000 \
#      -alias english-path-key
#
# 2. Copy this file to android/key.properties
# 3. Fill in the values below with your actual keystore information

storeFile=../english-path-release-key.jks
storePassword=YOUR_STORE_PASSWORD_HERE
keyAlias=english-path-key
keyPassword=YOUR_KEY_PASSWORD_HERE
